<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg129091.ui.ControlloInterfaccia">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER" spacing="50.0">
        <Label fx:id="infoGiocatore" style="-fx-font-weight: bold;" text="Giocatore" />
        <Label fx:id="infoMostro" style="-fx-font-weight: bold;" text="Mostro" />
    </HBox>

    <TextArea fx:id="areaLog" editable="false" prefHeight="200.0" />

    <VBox fx:id="pannelloMosse" alignment="CENTER" spacing="5.0" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="bottoneSalva" onAction="#gestisciSalvataggio" text="Salva Partita" />
        <Button fx:id="bottoneAvanti" disable="true" onAction="#gestisciProssimoMostro" text="Prossimo Mostro" />
    </HBox>
</VBox>